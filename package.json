{
  "name": "explore-forge-assets-import",
  "version": "1.1.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "changelog": "git cliff",
    "check": "lefthook run pre-push --force",
    "clean": "rm -rf ./dist",
    "forge:deploy": "secretspec run --provider dotenv --reason \"npm run forge:deploy\" -- sh -c 'forge deploy --non-interactive --environment \"$FORGE_ENVIRONMENT\"'",
    "forge:install": "secretspec run --provider dotenv --reason \"npm run forge:install\" -- sh -c 'forge install --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\" --non-interactive'",
    "forge:register": "forge register",
    "forge:uninstall": "secretspec run --provider dotenv --reason \"npm run forge:uninstall\" -- sh -c 'forge uninstall --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\"'",
    "forge:upgrade": "secretspec run --provider dotenv --reason \"npm run forge:upgrade\" -- sh -c 'forge install --upgrade --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\" --non-interactive'",
    "forge:variables:set": "node scripts/forge-vars-from-secretspec.js",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:forge": "forge lint",
    "lint:prelint": "ast-grep scan --config node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml --globs '!node_modules/**'",
    "prepare": "lefthook install",
    "size": "npm run build && size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "todo": "grep -rn 'TODO' --exclude='package.json' . --color=auto || echo 'No TODOs found!'",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge/api": "^8.0",
    "@forge/bridge": "^6.0",
    "@forge/events": "^3.0",
    "@forge/kvs": "^2.0",
    "@forge/react": "^12.0",
    "@forge/resolver": "^2.0",
    "react": "^18.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44",
    "@biomejs/biome": "^2.5",
    "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types#v0.1.2",
    "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
    "@size-limit/file": "^12.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1",
    "archunit": "^2.1",
    "lefthook": "^1.9",
    "size-limit": "^12.1",
    "typescript": "^5.9",
    "vitest": "^4.1",
    "yaml": "^2.9"
  },
  "engines": {
    "node": "24.x"
  },
  "size-limit": [
    {
      "name": "Backend (dist/**/*.js, excluding frontend)",
      "path": [
        "dist/**/*.js",
        "!dist/frontend/**"
      ],
      "limit": "40 KB"
    },
    {
      "name": "Frontend (dist/frontend/index.js)",
      "path": "dist/frontend/index.js",
      "limit": "10 KB"
    }
  ]
}
