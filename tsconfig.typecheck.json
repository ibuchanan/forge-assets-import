{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* No-emit: this config only ever runs `tsc --noEmit`-style checks. */
    "noEmit": true,

    /* Stricter than the deploy-time config: catches dead code that
       `tsconfig.json` intentionally leaves unchecked so the Forge bundler
       config stays focused on transpile correctness, not code hygiene. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitOverride": true,

    /* Already true via `extends` (tsconfig.json sets both), restated here
       explicitly because Forge prelint checks this file's own compilerOptions
       and doesn't follow `extends` — see require-tsconfig-typecheck-* rules. */
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true
  }
}
